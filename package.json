{
  "name": "minhapesquisa",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint:spec": "spectral lint contracts/openapi.yaml",
    "build": "npm run build -w @minhapesquisa/db && npm run build -w @minhapesquisa/motor-leitura && npm run build -w @minhapesquisa/api",
    "typecheck:tests": "tsc -p tests",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:relatorio": "node tools/testes.mjs",
    "demo": "npm run build && node apps/api/dist/demo/main.js",
    "local": "npm run build && node apps/api/dist/scripts/cli.js",
    "iniciar": "npm run build && node apps/api/dist/main.js",
    "lint": "eslint .",
    "test:mutacao": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@napi-rs/canvas": "1.1.0",
    "@stoplight/spectral-cli": "^6.14.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "eslint": "9.39.5",
    "exifr": "7.1.3",
    "fast-check": "4.10.2",
    "jsqr": "1.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "piexifjs": "1.0.6",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "type": "module",
  "overrides": {
    "qs": "6.17.1"
  }
}
