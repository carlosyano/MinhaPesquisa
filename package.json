{
  "name": "minhapesquisa",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint:spec": "spectral lint contracts/openapi.yaml",
    "build": "npm run build -w @minhapesquisa/db && npm run build -w @minhapesquisa/api",
    "typecheck:tests": "tsc -p tests",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "test:mutacao": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stoplight/spectral-cli": "^6.14.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  },
  "type": "module"
}
